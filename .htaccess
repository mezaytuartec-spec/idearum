# ============================================================================
# Idearum — .htaccess (Apache / LiteSpeed, que es lo que usa Hostinger)
#
# Sin este archivo, Hostinger puede seguir sirviendo el CSS y el JS viejos
# durante semanas despues de subir una actualizacion.
#
# HTML / CSS / JS / datos : se revalidan en cada visita.
# Imagenes y fuentes      : cache largo (cambian poco).
# ============================================================================

# ----- Duracion de cache -----
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType text/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"

  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  ExpiresByType audio/mpeg "access plus 1 month"

  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ----- Cache-Control -----
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|ico|woff|woff2|mp3|m4a|wav)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----- Tipos MIME (algunos hosting compartidos los sirven mal) -----
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType audio/mpeg .mp3
  AddType audio/mp4 .m4a

  AddDefaultCharset UTF-8
  AddCharset UTF-8 .html .css .js .json
</IfModule>

# ----- Compresion -----
# El HTML, el CSS, el JS y data/pistas.js son texto: viajan a un cuarto de su
# peso. Las imagenes y los MP3 NO se listan a proposito: ya vienen comprimidos
# y volver a comprimirlos solo gasta procesador del servidor.

# Brotli es lo que usa LiteSpeed (el servidor de Hostinger) y aprieta mas que
# gzip. Si el hosting no lo tiene, este bloque se ignora solo y queda el de
# abajo.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain
</IfModule>

# Avisa a los proxies que el mismo archivo se sirve comprimido o sin comprimir
# segun el navegador, para que no guarden la version equivocada.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# ----- Redireccion a HTTPS (descomentar cuando el dominio tenga SSL activo) -----
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# ----- Pagina de inicio -----
DirectoryIndex index.html
